# traffic66 inventory — copy to <data directory>/inventory.txt, or edit it
# in the web UI under Sources → Names. Every line is optional.
#
# net    <prefix>            <name>          networks that are yours
net 10.0.0.0/8 Internal
net 192.168.0.0/16 Office country=JP
# country=XX (two letters) places a network on the world map: lines are drawn
# from that country to the countries it talks to
#
# device <exporter address>  <name> [unsampled]
device 192.0.2.1 Core router
#
# iface  <exporter address> <ifIndex> <name> [speed=<bits per second>]
iface 192.0.2.1 3 ISP uplink speed=1000000000
#
# host   <address>           <name>
host 192.168.1.10 File server
#
# snmp   <exporter address> <community> [<management address>[:port]]
# reads interface counters (SNMPv2c, IF-MIB) to check the flow numbers
snmp 192.0.2.1 public
